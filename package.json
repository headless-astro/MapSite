{
  "name": "map-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Infinity-Nikki-style additive interactive resource/NPC map. Static, no backend.",
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "predev": "npm run build:data",
    "dev": "vite",
    "prebuild": "npm run build:data",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "pretest": "npm run build:data",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4"
  }
}
